# Template — copy to `.env` and fill in real values. `.env` is gitignored.
# `source .env` before running scripts/onboard-linux.sh or the az CLI.

# Azure connection (from `az login`)
AZURE_ACCOUNT_EMAIL=you@example.com
AZURE_SUBSCRIPTION_NAME="Azure subscription 1"
AZURE_SUBSCRIPTION_ID=<subscription-id>
AZURE_TENANT_ID=<tenant-id>
AZURE_TENANT_DOMAIN=<tenant>.onmicrosoft.com

# Azure resources
AZURE_RESOURCE_GROUP=arc-hybrid-lab
AZURE_LOCATION=koreacentral
AZURE_VM_NAME=cloud-vm

# Local VMs (Multipass)
LOCAL_VM_01=vm-01
LOCAL_VM_02=vm-02
LOCAL_VM01_IP=<local-ip>
LOCAL_VM02_IP=<local-ip>

# Budget (Cost Management)
AZURE_BUDGET_NAME=lab-budget
AZURE_BUDGET_AMOUNT_USD=2

# Tailscale (mesh connected)
TAILSCALE_VM01_IP=<tailscale-ip>
TAILSCALE_VM02_IP=<tailscale-ip>

# Service principal (Arc onboarding)
AZURE_SP_CLIENT_ID=<sp-client-id>
AZURE_SP_CLIENT_SECRET=<sp-client-secret>
